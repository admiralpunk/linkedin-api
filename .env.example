# === LinkedIn session cookies (backend credentials) ===
# Log into linkedin.com in a browser, open DevTools > Application > Cookies,
# and copy the values below. Keep these SECRET — never commit the real .env.

# The `li_at` auth cookie value (long token).
LI_AT=

# The `JSESSIONID` cookie value. Include the surrounding quotes and "ajax:" prefix,
# e.g. JSESSIONID="ajax:1234567890123456789"
JSESSIONID=

# === Voyager GraphQL (REQUIRED — the legacy REST endpoint now returns HTTP 410) ===
# queryId values are version-pinned hashes that change on LinkedIn deploys. Capture them
# from a logged-in browser: DevTools > Network > filter "graphql", open a profile, and copy
# the queryId + variables from the profile request(s). Refresh these when you start getting 410.
#
# Primary profile query (top card: name/headline/location/about/images), e.g.
#   voyagerIdentityDashProfiles.abcdef0123456789abcdef0123456789
GQL_PROFILE_QUERY_ID=
# Optional: the query that returns the section cards (experience/education/skills/...).
GQL_CARDS_QUERY_ID=

# Browser tracking headers LinkedIn expects on GraphQL calls. Copy the exact values of the
# `x-li-track` and `x-li-page-instance` request headers from the same captured request.
# LI_TRACK={"clientVersion":"1.13.x","mpName":"voyager-web","osName":"web",...}
# LI_PAGE_INSTANCE=urn:li:page:d_flagship3_profile_view_base;<base64>
LI_TRACK=
LI_PAGE_INSTANCE=

# === API access control ===
# Clients must send this as the `X-API-Key` header. Leave blank to disable auth
# (NOT recommended for a public deployment — it protects your cookie/quota).
API_KEY=

# === Tuning ===
# Cache time-to-live per profile, in seconds (default 43200 = 12h).
CACHE_TTL=43200

# Max profile requests allowed per client IP per minute.
RATE_LIMIT_PER_MINUTE=10

# Comma-separated CORS origins ("*" for all).
CORS_ORIGINS=*

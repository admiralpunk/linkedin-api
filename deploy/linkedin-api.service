# Alternative to Docker: run directly on an EC2 host with systemd.
#   sudo cp deploy/linkedin-api.service /etc/systemd/system/
#   sudo install -m 600 .env /etc/linkedin-api.env   # secrets, root-only
#   sudo systemctl daemon-reload && sudo systemctl enable --now linkedin-api
# Then front it with Caddy/nginx for TLS.
[Unit]
Description=LinkedIn Profile API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/linkedin-profile-api
EnvironmentFile=/etc/linkedin-api.env
ExecStart=/opt/linkedin-profile-api/.venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 --bind 127.0.0.1:8000 --timeout 60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
